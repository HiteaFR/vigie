#!/bin/sh
# ARP scan of the local network for Vigie (network module): JSON on standard output. Run by
# net-scan.service, which only has CAP_NET_RAW. No argument is read and nothing comes from the
# dashboard: the interface and the network are read from /etc/net-scan.conf (root:root 0644),
# written by install.sh:
#
#   IFACE=eth0
#   CIDR=192.168.10.0/24
#
# Strict validation, the file is never executed: each key once only;
# IFACE ^[A-Za-z0-9_.-]{1,15}$ ; CIDR a PRIVATE IPv4 range (10/8, 172.16/12, 192.168/16), no
# leading zero, prefix from 16 to 30 (never a scan of a whole /8). File missing,
# unreadable or invalid: JSON "ok":false with the reason, no scan.
# Variables read by the test bench only: NET_SCAN_DEMO=file replays a recorded arp-scan output
# instead of scanning; NET_SCAN_CONF=file replaces /etc/net-scan.conf.
#
# Output: {"v":1,"ts":<ms>,"iface":…,"cidr":…,"ms":<duration>,"ok":true,"hosts":[{"ip","mac","hdrmac","dup"}]}
# hdrmac is null and dup 0 for a normal reply: arp-scan 1.10 only fills ${hdrmac} when the
# Ethernet header MAC differs from the ARP sender, and ${dup} only for a duplicate reply;
# otherwise the field is EMPTY (and a warning goes to stderr, discarded).
# or, on failure, "ok":false and "error": a short text fixed here (and arp-scan's exit
# code), NEVER arp-scan's error output; capped at 80 characters, with no quote, \ or
# control character. Exit code 0 in both cases: the failure file is written, and the
# dashboard reads it.
# set -u without -e: every failure is handled (fail) so that a JSON is ALWAYS written, ok:false
set -u
export LC_ALL=C
CONF=${NET_SCAN_CONF:-/etc/net-scan.conf}
IFACE=""
CIDR=""

# milliseconds: %N comes from GNU date (coreutils), not POSIX; assumed on Debian
now() { date +%s%3N; }

start=$(now)
out=$(mktemp) || exit 1
trap 'rm -f "$out"' EXIT

fail() {
  msg=$(printf '%s' "$1" | tr -d '"\\' | tr -c '[:print:]' ' ' | cut -c1-80)
  printf '{"v":1,"ts":%s,"iface":"%s","cidr":"%s","ms":%s,"ok":false,"error":"%s"}\n' \
    "$start" "$IFACE" "$CIDR" "$(($(now) - start))" "$msg"
  exit 0
}

# failure messages in ASCII (fail() replaces any other byte). Configuration: two keys, one per line, read by grep (never "." or eval); any other
# non-empty, non-comment line makes it invalid
[ -r "$CONF" ] || fail "config missing ($CONF)"
extra=$(grep -vE '^[[:space:]]*(#.*)?$|^(IFACE|CIDR)=[^[:space:]]*$' "$CONF" | head -n 1)
[ -z "$extra" ] || fail "config invalid: unexpected line"
# each key once only (never "the last one wins")
[ "$(grep -cE '^IFACE=' "$CONF")" -le 1 ] && [ "$(grep -cE '^CIDR=' "$CONF")" -le 1 ] || fail "config invalid: duplicate key"
iface=$(grep -E '^IFACE=' "$CONF" | tail -n 1 | cut -d= -f2-)
cidr=$(grep -E '^CIDR=' "$CONF" | tail -n 1 | cut -d= -f2-)
printf '%s' "$iface" | grep -Eqx '[A-Za-z0-9_.-]{1,15}' || fail "config invalid: IFACE"
IFACE=$iface
# private IPv4 CIDR, prefix 16 to 30, address inside the private block
cidr_ok=$(printf '%s' "$cidr" | awk -F'[./]' '
  NF == 5 {
    # no leading zero (010 would be read as octal elsewhere)
    for (i = 1; i <= 4; i++) if ($i !~ /^(0|[1-9][0-9]?[0-9]?)$/ || $i + 0 > 255) { print 0; exit }
    if ($5 !~ /^[1-9][0-9]$/ || $5 + 0 < 16 || $5 + 0 > 30) { print 0; exit }
    a = $1 + 0; b = $2 + 0
    print ((a == 10) || (a == 172 && b >= 16 && b <= 31) || (a == 192 && b == 168)) ? 1 : 0
    exit
  }
  { print 0 }')
[ "$cidr_ok" = 1 ] || fail "config invalid: CIDR (private IPv4, prefix 16 to 30)"
CIDR=$cidr

# arp-scan's stderr (per-line warnings, libpcap messages): discarded, never copied
rc=0
if [ -n "${NET_SCAN_DEMO:-}" ]; then
  cat -- "$NET_SCAN_DEMO" >"$out" 2>/dev/null || fail "demo: cannot read file"
else
  # neither --quiet (would lose ${hdrmac}) nor --ignoredups (would hide duplicate replies):
  # they are the only signs of spoofing; no vendor text is requested
  # shellcheck disable=SC2016 # ${ip}… are arp-scan fields, not variables
  arp-scan -x -I "$IFACE" --retry=2 --timeout=400 --bandwidth=256K \
    --format='${ip}\t${mac}\t${hdrmac}\t${dup}' "$CIDR" >"$out" 2>/dev/null || rc=$?
  [ "$rc" -eq 0 ] || fail "arp-scan: failed, code $rc" # ASCII: fail() replaces any other byte
fi

# only IPv4<TAB>MAC<TAB>[MAC]<TAB>[integer] lines get through (the last two fields empty
# for a normal reply); everything else (header, summary, booby-trapped line) is
# dropped, even though -x already removes it
hosts=$(awk -F '\t' '
  function ip4(s,  a, i) {
    if (split(s, a, ".") != 4) return 0
    for (i = 1; i <= 4; i++) if (a[i] !~ /^[0-9][0-9]?[0-9]?$/ || a[i] + 0 > 255) return 0
    return 1
  }
  BEGIN { h = "[0-9a-fA-F][0-9a-fA-F]"; mac = "^" h ":" h ":" h ":" h ":" h ":" h "$" }
  NF == 4 && ip4($1) && $2 ~ mac && ($3 == "" || $3 ~ mac) && ($4 == "" || ($4 ~ /^[0-9]+$/ && length($4) <= 6)) {
    hdr = $3 == "" ? "null" : "\"" tolower($3) "\""
    printf "%s{\"ip\":\"%s\",\"mac\":\"%s\",\"hdrmac\":%s,\"dup\":%d}", sep, $1, tolower($2), hdr, $4 + 0
    sep = ","
  }' "$out") || fail "awk filter failed"

printf '{"v":1,"ts":%s,"iface":"%s","cidr":"%s","ms":%s,"ok":true,"hosts":[%s]}\n' \
  "$start" "$IFACE" "$CIDR" "$(($(now) - start))" "$hosts"

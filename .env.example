# Server secrets: copy to .env (never committed). In production, an environment file outside the
# deployed tree, mode 0600 (for example /etc/vigie/vigie.env, see deploy/vigie.service.example)
PORT=8088

# Proxmox: variables prefixed by proxmox[].env of config.json (here "PVE"), PVEAuditor token
# (read only). <env>_HOST overrides the URL of config.json (optional)
# PVE_HOST=https://pve.example.net:8006
PVE_TOKEN_ID=vigie@pve!read
PVE_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# second cluster (proxmox[].env "PVE_LAB", the prefix npm run init suggests for id "lab"):
# PVEAuditor token, privsep=1
# PVE_LAB_TOKEN_ID=vigie@pve!read
# PVE_LAB_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Gitea: token with read:repository, read:user, read:admin (runners)
GITEA_URL=https://gitea.example.net
GITEA_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram (@BotFather): chat_id through `node scripts/telegram-chatid.js`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# Dead man's switch (healthchecks.io, period 1 min, grace 5 min)
HEALTHCHECKS_PING_URL=
# Icons: folder of the downloaded icons (default: $STATE_DIRECTORY/icons, else <root>/data/icons)
# ICONS_DIR=
# Pinned CAs of the Proxmox clusters: folder of the <name>.pem files (default: server/pki)
# PKI_DIR=
# dash-report agent: SSH key (default $STATE_DIRECTORY/ssh/id_ed25519, known_hosts next to it)
# DASHREPORT_SSH_KEY=
# Versions: fine-grained GitHub token without any permission (optional, 60 → 5,000 requests/h)
# GITHUB_TOKEN=

# Widgets (services[].widget.auth.secretEnv of config.json): one name per secret
PIHOLE_PASSWORD=
GLUETUN_KEY=
QBIT_USER=
QBIT_PASSWORD=
PROWLARR_KEY=
SEERR_KEY=
RADARR_KEY=
SONARR_KEY=
HA_TOKEN=
PLEX_TOKEN=
TAILSCALE_KEY=

# 1 = notifications logged, not sent (tests)
ALERTS_DRY_RUN=

# Admin session (hash generated by `node scripts/admin-password.js`, never the password)
ADMIN_PASSWORD_HASH=
# networks allowed to log in and write: preferably security.adminCidrs in the config; when not
# empty, this variable wins; empty or absent: the config, else the loopback only
# ADMIN_ALLOWED_CIDRS=10.0.0.0/24,127.0.0.1/32
# 1 = Telegram bot off (test instance; use a separate bot for development)
# BOT_DISABLED=

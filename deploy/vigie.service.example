# Example systemd unit for Vigie (generic: copy it to /etc/systemd/system/vigie.service and adapt
# it). Code in /opt/vigie; config and CAs outside the deployed tree, in /etc/vigie:
#   /etc/vigie/config.json     (CONFIG_PATH; root:root 0644, no secret)
#   /etc/vigie/pki/<name>.pem  (PKI_DIR; pinned CAs of Proxmox over https, "pki/<name>.pem" in the
#                               config)
#   /etc/vigie/vigie.env       (secrets: tokens, passwords; root:root 0600, optional)
# State (SQLite database, icons): /var/lib/vigie (StateDirectory, exported as STATE_DIRECTORY).
# Hardening: the service writes only to its StateDirectory; it reads /opt/vigie, /etc/vigie,
# /run/net-scan and /proc/net/route; it listens on one TCP port and 5353/udp (mDNS); it runs ssh and ip.
# Listen address (default 127.0.0.1), anonymous reading, login over HTTP and admin networks: in
# config.json (listenHost, security; see docs/configuration.md), not here: an empty variable in the
# environment file would override an Environment= line of this unit, whereas it is ignored against
# the config.
[Unit]
Description=Vigie, homelab dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vigie
WorkingDirectory=/opt/vigie/server
EnvironmentFile=-/etc/vigie/vigie.env
Environment=NODE_ENV=production
Environment=CONFIG_PATH=/etc/vigie/config.json
Environment=PKI_DIR=/etc/vigie/pki
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning index.js
StateDirectory=vigie
StateDirectoryMode=0750
Restart=on-failure
RestartSec=3
# only to listen on a port below 1024 (PORT=80) without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_NETLINK: os.networkInterfaces() and ip neigh; AF_UNIX: ssh ControlMaster
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
